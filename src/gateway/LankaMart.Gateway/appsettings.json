{
  "AllowedHosts": "*",
  "Otel": { "Endpoint": "" },
  "ReverseProxy": {
    "Routes": {
      "identity-ping": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/identity/{**rest}" },
        "Transforms": [ { "PathPattern": "/api/v1/{**rest}" } ]
      },
      "catalog-ping": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/catalog/{**rest}" },
        "Transforms": [ { "PathPattern": "/api/v1/{**rest}" } ]
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5101/" } } },
      "catalog":  { "Destinations": { "d1": { "Address": "http://localhost:5103/" } } }
    }
  }
}
